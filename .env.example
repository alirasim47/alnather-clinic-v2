# Local Docker Compose PostgreSQL connection string. Use host=db and port=5432 here.
# Production on Supabase: provide its Transaction Pooler URI as a protected DATABASE_URL.
DATABASE_URL=postgresql://clinic_user:replace-with-a-strong-db-password@db:5432/alnather_clinic
# Compose sets DATABASE_SSL=false locally. Production defaults to TLS in the Docker image.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Cookie security defaults to true. For local HTTP only, explicitly set false with APP_ORIGIN
# on localhost/loopback; production external origins remain Secure even if misconfigured.
COOKIE_SECURE=true
# Set to the exact public HTTPS origin in production to enforce same-origin mutations.
APP_ORIGIN=http://localhost:3000

# PostgreSQL container bootstrap (never reuse these example values).
POSTGRES_DB=alnather_clinic
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Required only once when creating the initial clinic administrator.
CLINIC_NAME=عيادة الناظر
CLINIC_SLUG=alnather
ADMIN_NAME=مدير العيادة
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD
